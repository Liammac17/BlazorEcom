<form class="search-form" role="search" @onsubmit="HandleSearch" @onsubmit:preventDefault>
    <label class="sr-only" for="product-search">Search products</label>
    <div class="search-field">
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.8" /><path d="m16 16 5 5" /></svg>
        <input id="product-search" type="search" placeholder="Search products" @bind="filter" @bind:event="oninput" maxlength="150" autocomplete="off" />
    </div>
    <button type="submit" class="btn btn-primary">Search</button>
</form>

@code {
    private string filter = string.Empty;

    [Parameter]
    public EventCallback<string> OnSearch { get; set; }

    private Task HandleSearch() => OnSearch.InvokeAsync(filter.Trim());
}
