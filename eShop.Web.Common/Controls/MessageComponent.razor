@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="notice @variant" role="alert">
        <span>@message</span>
        <button type="button" class="notice-close" aria-label="Dismiss message" @onclick="HandleClose">×</button>
    </div>
}

@code {
    private string message;
    private string variant;

    public void ShowInfo(string info) => Show(info, "notice-info");
    public void ShowWarning(string warning) => Show(warning, "notice-warning");
    public void ShowError(string error) => Show(error, "notice-error");

    private void Show(string text, string className)
    {
        message = text;
        variant = className;
        StateHasChanged();
    }

    private void HandleClose() => message = string.Empty;
}
