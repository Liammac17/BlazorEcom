<article class="product-card">
    <a class="product-image-link" href="@($"/product/{Product.ProductId}")" aria-label="@($"View {Product.Name}")"><span class="product-brand-tag">@Product.Brand</span><img src="@Product.ImageLink" alt="@Product.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/product-placeholder.svg'" /><span class="product-view" aria-hidden="true">View product <span>↗</span></span></a>
    <div class="product-card-info"><span class="eyebrow product-brand">@Product.Brand</span><h3><a href="@($"/product/{Product.ProductId}")">@Product.Name</a></h3><div class="product-card-bottom"><span class="product-price">@Product.Price.ToString("C2")</span><a class="product-arrow" href="@($"/product/{Product.ProductId}")" aria-label="@($"Shop {Product.Name}")">↗</a></div></div>
</article>

@code { [Parameter] public Product Product { get; set; } }
