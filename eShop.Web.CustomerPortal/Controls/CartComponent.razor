@implements IDisposable
@inject IShoppingCartStateStore CartState
@inject Microsoft.Extensions.Logging.ILogger<CartComponent> Logger

<span class="bag-label">Bag</span><span class="cart-count" aria-live="polite" aria-label="@($"{count} items in bag")">@count</span>

@code {
    private int count;
    private bool disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        CartState.AddStateChangeListeners(OnCartChanged);
        await Refresh();
    }
    private void OnCartChanged() { _ = Refresh(); }
    private async Task Refresh()
    {
        try { var next = await CartState.GetLineItemsCount(); if (!disposed) await InvokeAsync(() => { count = next; StateHasChanged(); }); }
        catch (Exception ex) { Logger.LogWarning(ex, "Unable to refresh bag count"); }
    }
    public void Dispose() { disposed = true; CartState.RemoveStateChangeListeners(OnCartChanged); }
}
