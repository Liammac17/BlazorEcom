<aside class="order-summary" aria-label="Order summary"><h2>Order summary</h2><dl><div><dt>Items (@count)</dt><dd>@total.ToString("C2")</dd></div></dl><div class="summary-total"><span>Total</span><strong>@total.ToString("C2")</strong></div>@if (!HidePlaceOrderButton && count > 0) { <a class="btn btn-primary btn-full" href="/placeorder">Checkout <span aria-hidden="true">↗</span></a> }<a class="summary-continue" href="/products">Continue shopping</a></aside>

@code {
    [Parameter] public Order Order { get; set; }
    [Parameter] public bool HidePlaceOrderButton { get; set; }
    private int count => Order?.LineItems?.Sum(item => item.Quantity) ?? 0;
    private decimal total => Order?.LineItems?.Sum(item => item.Price * item.Quantity) ?? 0m;
}
