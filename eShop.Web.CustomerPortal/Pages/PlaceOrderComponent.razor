<PageTitle>Checkout · MyShop</PageTitle>
@page "/placeorder"
@inject NavigationManager Navigation
@inject IViewShoppingCartUseCase ViewCart
@inject IPlaceOrderUseCase PlaceOrder
@inject Microsoft.Extensions.Logging.ILogger<PlaceOrderComponent> Logger

<section class="page-container inner-page"><a class="back-link" href="/cart">← Back to your bag</a><div class="page-heading"><h1>Checkout</h1></div>
@if (error != null) { <div class="notice notice-error" role="alert">@error</div> }
@if (loading) { <div class="loading-state" role="status">Loading…</div> }
else if (order?.LineItems?.Count > 0) { <div class="checkout-layout"><CustomerFormComponent OnCustomerInfoSubmitted="SubmitOrder" IsSubmitting="submitting" /><OrderSummaryComponent Order="order" HidePlaceOrderButton="true" /></div> }
else { <div class="empty-state"><h2>Your bag is empty.</h2><a class="btn btn-primary" href="/products">Shop products</a></div> }
</section>

@code {
    private Order order;
    private string error;
    private bool loading = true;
    private bool submitting;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { order = await ViewCart.Execute(); }
        catch (Exception ex) { Logger.LogWarning(ex, "Unable to prepare checkout"); error = "Couldn't load checkout. Return to your bag and try again."; }
        finally { loading = false; StateHasChanged(); }
    }
    private async Task SubmitOrder(CustomerViewModel customer)
    {
        if (submitting || order == null) return;
        submitting = true; error = null;
        try
        {
            order.CustomerName = customer.CustomerName; order.CustomerAddress = customer.CustomerAddress; order.CustomerCity = customer.CustomerCity; order.CustomerStateProvince = customer.CustomerStateProvince; order.CustomerCountry = customer.CustomerCountry;
            var uniqueId = await PlaceOrder.Execute(order);
            if (string.IsNullOrWhiteSpace(uniqueId)) error = "Your bag, prices, or address details changed. Review them before ordering.";
            else Navigation.NavigateTo($"/orderconfirm/{Uri.EscapeDataString(uniqueId)}");
        }
        catch (Exception ex) { Logger.LogError(ex, "Checkout could not complete"); error = "Couldn't place your order. Try again."; }
        finally { submitting = false; }
    }
}
