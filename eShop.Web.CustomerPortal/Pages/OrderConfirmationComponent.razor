<PageTitle>Order confirmation · MyShop</PageTitle>
@page "/orderconfirm/{uid}"
@inject IViewOrderConfirmationUseCase ViewConfirmation
@inject Microsoft.Extensions.Logging.ILogger<OrderConfirmationComponent> Logger

<section class="page-container inner-page">
@if (order == null) { <div class="empty-state"><h1>Order not found.</h1><p>@(error ?? "Check the confirmation link and try again.")</p><a class="btn btn-primary" href="/products">Shop products</a></div> }
else {
    <div class="confirmation-heading"><span class="confirmation-check" aria-hidden="true">✓</span><h1>Order placed.</h1><span class="order-reference">ORDER #@order.OrderId · @order.DatePlaced?.ToString("dd MMM yyyy")</span></div>
    <div class="confirmation-layout"><div><section class="address-block"><span class="eyebrow">Shipping address</span><h2>@order.CustomerName</h2><p>@order.CustomerAddress<br />@order.CustomerCity, @order.CustomerStateProvince<br />@order.CustomerCountry</p></section>
    <div class="confirmation-items">@foreach (var item in order.LineItems) { <article class="confirmation-item"><img src="@(item.Product?.ImageLink ?? "/images/product-placeholder.svg")" alt="@(item.Product?.Name ?? "Ordered product")" onerror="this.onerror=null;this.src='/images/product-placeholder.svg'" /><div><span class="eyebrow">@(item.Product?.Brand ?? "MyShop")</span><h3>@(item.Product?.Name ?? $"Product #{item.ProductId}")</h3><p>Quantity @item.Quantity · @item.Price.ToString("C2") each</p></div><strong>@((item.Price * item.Quantity).ToString("C2"))</strong></article> }</div></div><OrderSummaryComponent Order="order" HidePlaceOrderButton="true" /></div>
}
</section>

@code {
    [Parameter] public string Uid { get; set; }
    private Order order;
    private string error;
    protected override void OnParametersSet()
    {
        order = null; error = null;
        if (!Guid.TryParse(Uid, out _)) return;
        try { order = ViewConfirmation.Execute(Uid); }
        catch (Exception ex) { Logger.LogWarning(ex, "Unable to load order confirmation"); error = "Couldn't load this order. Try again."; }
    }
}
