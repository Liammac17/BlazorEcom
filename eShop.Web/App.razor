<PageTitle>MyShop</PageTitle>
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Program).Assembly"

            AdditionalAssemblies="new[] {
            typeof(eShop.Web.CustomerPortal.Pages.ViewProductComponent).Assembly,
            typeof(eShop.Web.AdminPortal.Pages.OutstandingOrdersComponent).Assembly
        }">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <LoginComponent></LoginComponent>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <section class="empty-state page-container"><h1>Page not found.</h1><a class="btn btn-primary" href="/products">Shop products</a></section>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
